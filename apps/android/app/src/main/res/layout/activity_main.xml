<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/black_white_gradient_main_bg">

    <!-- Zone principale des fragments -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false" />

    <!-- Custom Bottom Navigation Bar (4 Tabs: Mission, IDE, Révisions, Paramètres) -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <!-- Tab 1: Mission -->
        <LinearLayout
            android:id="@+id/tab_mission"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_mission"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/code_simple"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/text_mission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_mission"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: IDE -->
        <LinearLayout
            android:id="@+id/tab_ide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_ide"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/code_window"
                app:tint="?attr/colorOutline" />

            <TextView
                android:id="@+id/text_ide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="IDE"
                android:textColor="?attr/colorOutline"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Révisions -->
        <LinearLayout
            android:id="@+id/tab_revision"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_revision"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_revision"
                app:tint="?attr/colorOutline" />

            <TextView
                android:id="@+id/text_revision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_revision"
                android:textColor="?attr/colorOutline"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Paramètres -->
        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_settings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_settings"
                app:tint="?attr/colorOutline" />

            <TextView
                android:id="@+id/text_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_settings"
                android:textColor="?attr/colorOutline"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
