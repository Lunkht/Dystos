<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingBottom="28dp"
    android:clipToOutline="true">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header title & subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Bjimo"
            android:src="@drawable/bjimo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="Assistant IA Bjimo"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:textColor="@color/dystos_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/btn_fermer"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/cross"
            app:tint="@color/dystos_on_surface"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="@color/dystos_surface_variant" />

    <!-- Prompt input box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/code_block_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editTextText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Que souhaitez-vous coder ?"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/dystos_on_surface"
            android:textColorHint="#8A9EA8"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btn_generer"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/algorithm_btn_bg"
            android:contentDescription="Générer"
            android:padding="8dp"
            android:src="@drawable/ai_algorithm" />
    </LinearLayout>

    <!-- Output code box -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="Code généré :"
        android:textColor="@color/dystos_on_surface_variant"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editTextTextMultiLine"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/code_block_bg"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:padding="14dp"
        android:textColor="@color/dystos_code_output"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <!-- Action buttons: fermer, générer, insérer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">


        <ImageView
            android:id="@+id/btn_inserer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:tint="@color/dystos_on_surface"
            android:src="@drawable/insert_square"/>
    </LinearLayout>

</LinearLayout>