<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quizDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_quiz_dialog"
    android:clipToOutline="true">

    <!-- En-tête -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:background="#06171C">

        <TextView
            android:id="@+id/tvCheckIcon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:gravity="center"
            android:text="✓"
            android:textSize="54sp"
            android:textColor="#29D2FF"
            android:background="@drawable/bg_quiz_check_circle"
            android:fontFamily="sans"
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="22dp"
            android:text="Fantastique !"
            android:textColor="#35CFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:maxLines="2"/>
    </LinearLayout>

    <!-- Zone centrale -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="30dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp"
        android:background="#005366">

        <TextView
            android:id="@+id/tvCharacterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ada Lovelace"
            android:textColor="#8BEAFF"
            android:textSize="25sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"/>

    </LinearLayout>

    <!-- Explication et bouton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        android:background="#06171C">

        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ada a créé le premier algorithme destiné à être exécuté par une machine, ce qui fait d'elle une pionnière de la programmation."
            android:textColor="#D4E1E6"
            android:textSize="19sp"
            android:lineSpacingExtra="6dp"/>

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:background="@drawable/bg_quiz_next"
            android:text="S U I V A N T"
            android:textColor="#003B4C"
            android:textSize="21sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Passer à la question suivante"/>

    </LinearLayout>

</LinearLayout>
