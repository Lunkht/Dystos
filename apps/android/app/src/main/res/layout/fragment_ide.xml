<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main IDE Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ide_bg"
        android:orientation="vertical">

        <!-- IDE Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tools_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="35dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="15dp">


            <!-- Toolbar Actions (Tools BG) -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="2dp">
                    <ImageView
                        android:id="@+id/btn_folder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Mes travaux"
                        android:focusable="true"
                        android:src="@drawable/menu_burger"
                        app:tint="?attr/colorOnSurface" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="2dp">
                    <!-- Open Icon -->
                    <ImageView
                        android:id="@+id/btn_open"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Ouvrir un fichier"
                        android:focusable="true"
                        android:src="@drawable/folder_open"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="2dp">
                    <!-- Reset Icon -->
                    <ImageView
                        android:id="@+id/btn_reset"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Réinitialiser"
                        android:focusable="true"
                        android:src="@drawable/refresh"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="2dp">
                    <!-- Search Icon -->
                    <ImageView
                        android:id="@+id/btn_search"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Rechercher dans le code"
                        android:focusable="true"
                        android:src="@drawable/search"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="2dp">
                    <!-- Run Icon -->
                    <ImageView
                        android:id="@+id/btn_run"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Exécuter"
                        android:focusable="true"
                        android:padding="2dp"
                        android:src="@drawable/play"
                        app:tint="@color/dystos_code_comment" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="2dp">
                    <!-- AI Assistant Icon -->
                    <ImageView
                        android:id="@+id/btn_ai"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Assistant IA Bjimo"
                        android:focusable="true"
                        android:src="@drawable/artificial_intelligence"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Open Files Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tab_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Quick Symbol Bar -->
        <dev.dystos.app.presentation.editor.SymbolBarView
            android:id="@+id/symbol_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp" />

        <!-- Code Editor with Line Numbers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <dev.dystos.app.presentation.editor.LineNumberView
                android:id="@+id/line_numbers"
                android:layout_width="30dp"
                android:layout_height="match_parent" />

            <dev.dystos.app.presentation.editor.CodeEditText
                android:id="@+id/code_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Search & Replace Bar -->
        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/code_block_bg"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Rechercher…"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A9EA8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/search_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:text="0/0"
                    android:textColor="#8BEAFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="▲"
                    android:textColor="#35CFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="▼"
                    android:textColor="#35CFFF"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/btn_close_search"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Fermer la recherche"
                    android:src="@drawable/cross"
                    app:tint="@color/dystos_on_surface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/replace_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Remplacer par…"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A9EA8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_replace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="Remplacer"
                    android:textColor="#4DD4C0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_replace_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="Tout"
                    android:textColor="#4DD4C0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Error Banner -->
        <TextView
            android:id="@+id/live_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:background="#2C1515"
            android:padding="8dp"
            android:textColor="#FFB4AB"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Terminal Console Output Panel -->
        <LinearLayout
            android:id="@+id/result_card"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/chapter_item_gradient_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/result_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="Console"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:text="Effacer"
                    android:textColor="?attr/colorOutline"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/code_block_bg"
                android:padding="8dp">

                <TextView
                    android:id="@+id/output_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#4DD4C0"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </ScrollView>
        </LinearLayout>

        <!-- Bottom Actions -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/btn_undo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:contentDescription="Annuler (Ctrl+Z)"
                    android:focusable="true"
                    android:src="@drawable/ic_undo"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/btn_redo"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:contentDescription="Rétablir (Ctrl+Y)"
                    android:focusable="true"
                    android:src="@drawable/ic_redo"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/btn_save"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:contentDescription="Enregistrer le fichier"
                    android:focusable="true"
                    android:src="@drawable/disk"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/btn_ide_settings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:contentDescription="Paramètres de l'IDE"
                    android:focusable="true"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>

    <!-- Side Navigation Drawer (Left) -->
    <LinearLayout
        android:id="@+id/nav_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0D0F0F"
        android:orientation="vertical"
        android:padding="16dp">
        <!-- Side Navigation Drawer functions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/tools_bg"
                    android:orientation="vertical"
                    android:layout_marginEnd="5dp"
                    android:padding="6dp">
                    <!-- Open Icon -->
                    <ImageView
                        android:id="@+id/search"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Ouvrir un fichier"
                        android:focusable="true"
                        android:src="@drawable/search"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/tools_bg"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <!-- git Icon -->
                    <ImageView
                        android:id="@+id/commit_git"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Réinitialiser"
                        android:focusable="true"
                        android:src="@drawable/code_branch"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/tools_bg"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <!-- share Icon -->
                    <ImageView
                        android:id="@+id/github"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Rechercher dans le code"
                        android:focusable="true"
                        android:src="@drawable/github"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/tools_bg"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <!-- AI Assistant Icon -->
                    <ImageView
                        android:id="@+id/share"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Assistant IA Bjimo"
                        android:focusable="true"
                        android:src="@drawable/share"
                        app:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/tools_bg"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <ImageView
                        android:id="@+id/btn_drawer_new"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        app:tint="?attr/colorOnSurface"
                        android:src="@drawable/plus" />

                </LinearLayout>
            </LinearLayout>


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_recycler_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
