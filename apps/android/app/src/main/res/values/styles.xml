<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Typographie Dystos.

      Deux familles suffisent : Barlow pour le texte, Barlow Condensed pour
      les titres (toujours en majuscules, comme le site), plus JetBrains Mono
      pour le code et les étiquettes. Aucune police n'est chargée à distance.
    -->

    <style name="TextAppearance.Dystos.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Dystos.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Étiquettes : mono, majuscules, interlignage large (comme le site). -->
    <style name="TextAppearance.Dystos.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Dystos.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Dystos.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Étiquette de section : mono, grise, très espacée. -->
    <style name="TextAppearance.Dystos.Kicker" parent="TextAppearance.Dystos.LabelMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Code : JetBrains Mono, ni gras ni italique par défaut. -->
    <style name="TextAppearance.Dystos.Code" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/dystos_code_on_background</item>
    </style>

    <!--
      Angles : 2 dp partout. Le site n'a ni arrondi généreux ni ombre.
    -->
    <style name="ShapeAppearance.Dystos.Corner" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">2dp</item>
    </style>

    <!--
      Styles de widgets communs.
    -->

    <!-- Carte à filet : surface pleine, contour 1 dp, angle 2 dp. -->
    <style name="Widget.Dystos.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">2dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

</resources>
