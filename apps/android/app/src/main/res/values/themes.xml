<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Fond principal de l'application : variantes claire et sombre. -->
    <attr name="mainBackground" format="reference" />

    <!-- Thème clair : fond blanc et éléments noirs. -->
    <style name="Theme.Dystos" parent="Theme.Material3.Light.NoActionBar">
        <item name="mainBackground">@drawable/black_white_gradient_main_bg_light</item>
        <item name="colorPrimary">@color/dystos_primary</item>
        <item name="colorOnPrimary">@color/dystos_on_primary</item>
        <item name="colorPrimaryContainer">@color/dystos_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/dystos_on_primary_container</item>
        <item name="colorSecondary">@color/dystos_secondary</item>
        <item name="colorOnSecondary">@color/dystos_on_secondary</item>
        <item name="android:colorBackground">@color/dystos_background</item>
        <item name="colorSurface">@color/dystos_surface</item>
        <item name="colorOnSurface">@color/dystos_on_surface</item>
        <item name="colorSurfaceVariant">@color/dystos_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/dystos_on_surface_variant</item>
        <item name="colorOutline">@color/dystos_outline</item>
        <item name="colorError">@color/dystos_error</item>
        <item name="colorOnError">@color/dystos_on_error</item>
        <item name="colorControlActivated">@color/dystos_primary</item>
        <item name="colorControlNormal">@color/dystos_outline</item>
        <item name="android:statusBarColor">@color/dystos_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/dystos_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowBackground">@drawable/black_white_gradient_main_bg_light</item>
        <item name="materialAlertDialogTheme">@style/Theme.Dystos.Dialog</item>
    </style>

    <style name="Theme.Dystos.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

</resources>