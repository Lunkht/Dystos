{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string"]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": ["string", "comment"]
    }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:def|class|interface|enum|if|elif|else|for|while|try|except|finally|with|match|case)\\b.*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:elif|else|except|finally|case)\\b.*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:def|class|interface|enum|if|elif|else|for|while|try|except|finally|with|match|case)\\b.*:\\s*(?:#.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
